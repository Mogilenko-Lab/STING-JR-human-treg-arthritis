# Data files (track structure via .gitkeep, not contents)
00_data/raw/*
!00_data/raw/.gitkeep
00_data/processed/*
!00_data/processed/.gitkeep
00_data/references/*
!00_data/references/.gitkeep
# Committed reference: the heat leading-edge gene taxonomy is an external-model
# classification (not deterministically regenerable by a prep script), so it is
# tracked as a frozen input with its provenance rather than ignored.
!00_data/references/heat_leadingedge_taxonomy/
!00_data/references/heat_leadingedge_taxonomy/**
# Committed reference: the symbol-alias map IS regenerable by 00_symbol_alias_map.R, so it
# is tracked for the opposite reason to the taxonomy above — its content depends on the
# org.Hs.eg.db release, and an untracked map lets a package upgrade silently change which
# genes a reference set recovers, moving set sizes and NES with no reviewable diff. Frozen
# here with its provenance so regenerating it is a deliberate act.
!00_data/references/symbol_alias/
!00_data/references/symbol_alias/**

# Per-accession raw mounts (00_data/<accession>/raw/) — heavy RO bytes; keep the
# committed provenance (PROVENANCE.md/manifest.json/samples.csv/download.sh) in the
# accession dir, never the raw payload (known-issue #3). Keep-dir via .gitkeep.
00_data/**/raw/**
!00_data/**/raw/.gitkeep

# Results — track the directory skeleton (.gitkeep) and caption READMEs, never artifacts.
# Hard-ignore checkpoint state objects at any depth (large + recomputable).
03_results/objects/**/*.h5ad
03_results/objects/**/*.rds
03_results/objects/**/*.rdata
03_results/objects/**/*.parquet
03_results/objects/*.h5ad
03_results/objects/*.rds
03_results/objects/*.rdata
03_results/objects/*.parquet

# Data artifacts within phase dirs. The tracked surface of 03_results/ is the
# narrative (stage README.md captions), the master/ accumulators, and the compact
# per-stage summary + figure-source tables. Rendered figures and bulk payload stay
# out: each is reproducible from a committed 02_analysis/scripts/NN_* plus its
# same-stem source table, and the payload runs to ~200 MB per full pipeline pass.
# Force-add an individual artifact with `git add -f` when it must be a record.

# Rendered figures — PDF+PNG twins; a single vector UMAP of ~50k cells is >10 MB.
03_results/**/figures/**/*.pdf
03_results/**/figures/**/*.png
03_results/**/figures/**/*.svg

# Bulk / binary tables — fgsea result objects, hook substrate, per-cell score
# matrices, full DE tables, transcriptome-length ranked lists, running-sum exports.
03_results/**/tables/**/*.rds
03_results/**/tables/**/*.parquet
03_results/**/tables/**/*.tsv
03_results/**/tables/**/per_cell_*.csv
03_results/**/tables/**/runsum_interactive_*.csv
03_results/**/tables/**/de_SFvsPB_*.csv
03_results/**/tables/**/pseudobulk_counts.csv
03_results/**/tables/**/qc_metrics_per_cell.csv
03_results/**/tables/**/mthi_treg_membership.csv

# Interactive-explorer tables (regenerable from scripts/export_explorers.py; binary).
03_results/interactive/*.parquet

# Notebook EDA scratch (lasso saves, snapshots) — exploratory, regenerable. Force-add a
# specific file with `git add -f` if you want to keep it as a record.
02_analysis/notebooks/**/eda/

# marimo app cache + exported static renders — regenerable from the .py app.
__marimo__/
02_analysis/notebooks/**/__marimo__/
02_analysis/notebooks/**/*.html

# Timestamped pre-change backups written by `sciagent provision` / vscode-sync-settings.
*.provc.*

# Scratch: throwaway artifacts, never committed
03_results/_scratch/*
!03_results/_scratch/.gitkeep

# Keep .gitkeep placeholders everywhere under 03_results/.
!03_results/**/.gitkeep

# Reference codebases (gitignored by default — add explicitly if needed)
01_modules/.ref/

# Logs
logs/
*.log

# Secrets and env
.env
.env.local
.env.*
!.env.example
*.pem
*.key
credentials.json
.mcp.json

# CLI auth configs
.gemini/
.codex/

# R artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Python artifacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*.log

# BEGIN SCIAGENT:GITIGNORE
docs/_internal/
.claude/
.agents/
.gemini/
.sciagent/
02_analysis/helpers/figure-style
.mcp.json
.env
.env.*
# END SCIAGENT:GITIGNORE
